{
  "mcpServers": {
    "pg-mcp": {
      "command": "uv",
      "args": [
        "run",
        "python",
        "src/pg_mcp/__main__.py"
      ],
      "cwd": "/absolute/path/to/pg-mcp",
      "env": {
        "OPENAI_API_KEY": "sk-your-api-key-here",
        "OPENAI_BASE_URL": "https://api.openai.com/v1",
        "OPENAI_MODEL": "gpt-5.2-mini"
      }
    }
  }
}
